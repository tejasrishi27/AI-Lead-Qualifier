import requests
import json
import pandas as pd
from google.colab import userdata
import csv

api_key = userdata.get("OPENROUTER_API_KEY")

if not api_key:
    raise ValueError(
        "OPENROUTER_API_KEY is missing. Add it to Google Colab Secrets."
    )

instruction = """
You are an intent classification and triage engine for a home services platform.

Analyze the user's message to extract:

1. Service: Identify the domain in 1-2 words.
2. Urgency: Low, Medium, or High.
3. Intent: Summarize intent in 2-4 words.
4. Buying: Low, Medium, or High.

Output ONLY valid JSON using exactly these keys:

{
    "Service": "...",
    "Urgency": "...",
    "Intent": "...",
    "Buying": "..."
}

Do not include markdown or additional text.
"""
file_name = input("enter the file name")
issues=[]
email=[]
name=[]
with open(file_name, mode='r', newline='', encoding='utf-8') as file:
    reader = csv.DictReader(file)
    for row in reader:
        issues.append(row["message"])
        name.append(row["customer_name"])
        email.append(row["email"])


def classify_lead(issue):
    if not issue or not issue.strip():
        raise ValueError("Customer issue cannot be empty.")
    try:
        response = requests.post(
            url="https://openrouter.ai/api/v1/chat/completions",
            headers={
                "Authorization": f"Bearer {api_key}",
                "Content-Type": "application/json"
            },
            json={
                "model": "nvidia/nemotron-3-nano-30b-a3b",
                "messages": [
                    {
                        "role": "system",
                        "content": instruction
                    },
                    {
                        "role": "user",
                        "content": issue
                    }
                ],

                "response_format": {
                    "type": "json_object"
                },

                "temperature": 0.0
            },
            timeout=30
        )

    except requests.exceptions.Timeout:
        raise RuntimeError(
            "The request timed out. Try again."
        )

    except requests.exceptions.ConnectionError:
        raise RuntimeError(
            "Could not connect to OpenRouter. Check your internet connection."
        )

    except requests.exceptions.RequestException as e:
        raise RuntimeError(
            f"Request failed: {e}"
        )

    if response.status_code != 200:

        try:
            error_data = response.json()

            error_message = error_data.get(
                "error",
                {}
            ).get(
                "message",
                "Unknown API error"
            )

        except json.JSONDecodeError:
            error_message = response.text

        if response.status_code == 401:
            raise RuntimeError(
                "401 Unauthorized: Check your OpenRouter API key."
            )

        elif response.status_code == 429:
            raise RuntimeError(
                "429 Rate limit reached. Try again later."
            )

        elif response.status_code >= 500:
            raise RuntimeError(
                f"OpenRouter server error: {error_message}"
            )

        else:
            raise RuntimeError(
                f"OpenRouter error ({response.status_code}): {error_message}"
            )

    try:

        data = response.json()

    except json.JSONDecodeError:
        raise RuntimeError(
            "OpenRouter returned invalid JSON."
        )

    if "error" in data:
        raise RuntimeError(
            f"OpenRouter Error: {data['error']}"
        )

    if not data.get("choices"):
        raise RuntimeError(
            "AI returned no classification result."
        )
    try:
        content = data["choices"][0]["message"]["content"]
    except (KeyError, TypeError):
        raise RuntimeError(
            "Unexpected response format from OpenRouter."
        )
    if not content:
        raise RuntimeError(
            "AI returned an empty response."
        )

    try:

        result = json.loads(content)

    except json.JSONDecodeError:

        cleaned_content = content.strip()

        if cleaned_content.startswith("```"):

            cleaned_content = (
                cleaned_content
                .split("\n", 1)[-1]
                .rsplit("```", 1)[0]
                .strip()
            )

        try:
            result = json.loads(cleaned_content)

        except json.JSONDecodeError:
            raise RuntimeError(
                f"AI returned invalid JSON:\n{content}"
            )
    required_fields = [
        "Service",
        "Urgency",
        "Intent",
        "Buying"
    ]

    for field in required_fields:

        if field not in result:
            raise RuntimeError(
                f"AI response is missing required field: {field}"
            )

    valid_levels = {
        "Low",
        "Medium",
        "High"
    }

    if result["Urgency"] not in valid_levels:

        raise RuntimeError(
            f"Invalid urgency returned by AI: {result['Urgency']}"
        )

    if result["Buying"] not in valid_levels:

        raise RuntimeError(
            f"Invalid buying level returned by AI: {result['Buying']}"
        )
    return result

urgency = {
    "High": 3,
    "Medium": 2,
    "Low": 1
}

buying = {
    "High": 3,
    "Medium": 2,
    "Low": 1
}

info = []
i = 0
for issue in issues:
    try:
        solution = classify_lead(issue)

        urg = urgency[solution["Urgency"]]
        buy = buying[solution["Buying"]]

        score = urg * buy

        if score >= 7:
            priority = "HOT"
        elif score >= 4:
            priority = "WARM"
        else:
            priority = "COLD"

        lead_data = {
            "Name": name[i],
            "Email": email[i],
            "Issue": issue,
            "Service": solution["Service"],
            "Urgency": solution["Urgency"],
            "Intent": solution["Intent"],
            "Buying": solution["Buying"],
            "Score": score,
            "Priority": priority

        }
        info.append(lead_data)
        i += 1
    except Exception as e:
        print(f" Failed to process lead:")
        print(f"   {issue}")
        print(f"   Error: {e}")
        print()


df = pd.DataFrame(info)

sort_df = df.sort_values(by="Score",ascending=False)

display(sort_df)

sort_df.to_csv("qualified_leads.csv",index=False)

